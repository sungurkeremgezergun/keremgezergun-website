:0 25px 50px -12px #0a162840;--radius:8px;--radius-lg:16px;--radius-xl:24px;--transition:all .3s ease}*,:before,:after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:var(--font-inter,\"Inter\"), -apple-system, BlinkMacSystemFont, sans-serif;color:var(--text-primary);background:var(--bg-primary);-webkit-font-smoothing:antialiased;font-size:16px;line-height:1.6}img{max-width:100%;height:auto;display:block}address{font-style:normal}a{color:inherit;transition:var(--transition);text-decoration:none}ul{list-style:none}.container{width:100%;max-width:1200px;margin:0 auto;padding:0 24px}h1,h2,h3,h4,h5,h6{font-family:var(--font-playfair,\"Playfair Display\"), Georgia, serif;color:var(--text-primary);font-weight:700;line-height:1.2}h1{font-size:clamp(2.5rem,5vw,4rem)}h2{font-size:clamp(2rem,4vw,3rem)}h3{font-size:clamp(1.25rem,2vw,1.5rem)}.btn{border-radius:var(--radius);cursor:pointer;transition:var(--transition);border:2px solid #0000;justify-content:center;align-items:center;gap:8px;padding:12px 24px;font-size:15px;font-weight:600;display:inline-flex}.btn-primary{background:var(--primary);color:#fff;border-color:var(--primary)}.btn-primary:hover{background:var(--primary-dark);border-color:var(--primary-dark);box-shadow:var(--shadow-md);transform:translateY(-2px)}.btn-outline{color:var(--text-primary);border-color:var(--border);background:0 0}.btn-outline:hover{border-color:var(--accent);color:var(--primary)}.btn-large{padding:16px 32px;font-size:16px}.btn-full{width:100%}.header{z-index:1000;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);background:#f8f6f0f2;position:fixed;top:0;left:0;right:0}.nav{justify-content:space-between;align-items:center;height:72px;display:flex}.logo-mark{align-items:center;line-height:0;display:inline-flex;text-decoration:none!important}.logo-mark img{width:180px;max-width:100%;height:auto;display:block}.logo-mark--footer img{border-radius:6px;width:220px}@media (max-width:768px){.logo-mark img{width:140px}.logo-mark--footer img{width:180px}}.nav-menu{align-items:center;gap:32px;display:flex}.nav-menu a{color:var(--text-secondary);font-size:15px;font-weight:500}.nav-menu a:hover{color:var(--primary);text-decoration:none}.nav-menu a.btn-primary{color:#fff;padding:10px 20px}.nav-menu a.btn-primary:hover{color:#fff}.hamburger{cursor:pointer;background:0 0;border:none;flex-direction:column;gap:5px;padding:8px;display:none}.hamburger span{background:var(--text-primary);width:24px;height:2px;transition:var(--transition)}.hero{background:linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);padding:140px 0 80px}.hero-content{grid-template-columns:1fr 1fr;align-items:center;gap:60px;display:grid}.hero-badge{color:var(--accent-text);background:linear-gradient(135deg,#c9a84c1f 0%,#c9a84c38 100%);border:1px solid #c9a84c4d;border-radius:50px;align-items:center;gap:8px;margin-bottom:24px;padding:8px 16px;font-size:14px;font-weight:600;display:inline-flex}.hero h1{margin-bottom:16px}.hero h1 .highlight{color:var(--accent-text);display:block}.hero-title{color:var(--text-secondary);margin-bottom:16px;font-size:20px;font-weight:600}.hero-description{color:var(--text-secondary);max-width:500px;margin-bottom:32px;font-size:18px}.hero-description strong{color:var(--text-primary)}.hero-stats{border-top:1px solid var(--border);border-bottom:1px solid var(--border);gap:40px;margin-bottom:32px;padding:24px 0;display:flex}.stat{text-align:center}.stat-number{color:var(--accent-text);font-size:32px;font-weight:800;display:block}.stat-label{color:var(--text-secondary);font-size:14px}.hero-cta{flex-wrap:wrap;gap:16px;display:flex}.hero-image{justify-content:center;display:flex}.image-wrapper{width:400px;height:480px;position:relative}.image-wrapper img{object-fit:cover;border-radius:var(--radius-xl);width:100%;height:100%;box-shadow:var(--shadow-lg)}.image-decoration{border:3px solid var(--accent);border-radius:var(--radius-xl);z-index:-1;width:100%;height:100%;position:absolute;top:-20px;right:-20px}.tools-section{background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:60px 0}.tools-title{text-align:center;color:var(--text-light);text-transform:uppercase;letter-spacing:2px;margin-bottom:32px;font-size:14px;font-weight:600}.tools-grid{flex-wrap:wrap;justify-content:center;align-items:center;gap:48px;display:flex}.tool-item{filter:grayscale();opacity:.6;width:120px;height:60px;transition:var(--transition);justify-content:center;align-items:center;display:flex}.tool-item:hover{filter:grayscale(0%);opacity:1;transform:scale(1.1)}.tool-item img{object-fit:contain;max-width:100px;max-height:40px}section{padding:100px 0}.section-header{text-align:center;margin-bottom:60px}.section-tag{background:var(--primary);color:#fff;text-transform:uppercase;letter-spacing:1px;border-radius:50px;margin-bottom:16px;padding:6px 16px;font-size:13px;font-weight:600;display:inline-block}.section-header h2{max-width:600px;margin:0 auto}.about-section{background:var(--bg-primary)}.about-content{gap:60px;display:grid}.about-text{text-align:center;max-width:800px;margin:0 auto}.about-text p{color:var(--text-secondary);margin-bottom:16px;font-size:18px}.about-text strong{color:var(--text-primary)}.expertise-grid{grid-template-columns:repeat(4,1fr);gap:24px;display:grid}.expertise-card{background:var(--bg-secondary);border-radius:var(--radius-lg);text-align:center;transition:var(--transition);border:1px solid var(--border);padding:32px 24px}.expertise-card:hover{box-shadow:var(--shadow-md);border-color:var(--primary);transform:translateY(-4px)}.expertise-icon{background:var(--primary);border-radius:12px;justify-content:center;align-items:center;width:56px;height:56px;margin:0 auto 16px;display:flex}.expertise-icon svg{stroke:#fff;width:28px;height:28px}.expertise-card h3{margin-bottom:8px;font-size:18px}.expertise-card p{color:var(--text-secondary);font-size:14px}.projects-section{background:var(--bg-primary)}.projects-grid{grid-template-columns:repeat(3,1fr);gap:24px;display:grid}.project-card{background:var(--bg-secondary);border-radius:var(--radius-lg);border:1px solid var(--border);transition:var(--transition);padding:32px}.project-card:hover{box-shadow:var(--shadow-md);transform:translateY(-4px)}.project-card.featured{background:linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);color:#fff;border:none;grid-column:span 1}.project-card.featured h3,.project-card.featured p{color:#fff}.project-badge{background:#fff3;border-radius:50px;margin-bottom:16px;padding:6px 12px;font-size:12px;font-weight:600;display:inline-block}.project-card h3{margin-bottom:12px}.project-card p{color:var(--text-secondary);margin-bottom:16px;font-size:15px}.project-tags{flex-wrap:wrap;gap:8px;display:flex}.project-tags li{background:#0000000d;border-radius:50px;padding:4px 12px;font-size:13px;font-weight:500}.project-card.featured .project-tags li{background:#fff3}.blog-section{background:var(--bg-secondary)}.blog-grid{grid-template-columns:repeat(4,1fr);gap:24px;display:grid}.blog-card{background:var(--bg-primary);border-radius:var(--radius-lg);border:1px solid var(--border);transition:var(--transition);overflow:hidden}.blog-card:hover{box-shadow:var(--shadow-md);transform:translateY(-4px)}.blog-image{background:linear-gradient(135deg, var(--bg-secondary) 0%, var(--border) 100%);height:200px}.blog-image.placeholder{justify-content:center;align-items:center;display:flex}.blog-content{padding:24px}.blog-category{color:var(--accent-text);background:#c9a84c1f;border-radius:50px;margin-bottom:12px;padding:4px 10px;font-size:12px;font-weight:600;display:inline-block}.blog-card h3{margin-bottom:8px;font-size:18px}.blog-card p{color:var(--text-secondary);font-size:14px}.ongoing-section{background:linear-gradient(135deg, var(--bg-dark) 0%, #0f2240 100%);padding:80px 0}.ongoing-section .section-header,.ongoing-section .section-header 